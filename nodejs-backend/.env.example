# Application
NODE_ENV=development
PORT=3000
APP_NAME=JusMoto
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=jusmoto
DB_USERNAME=root
DB_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=30d

# File Upload
UPLOAD_PATH=uploads
MAX_FILE_SIZE=10485760

# Email (SMTP)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@jusmoto.com
MAIL_FROM_NAME=JusMoto

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Payment Gateways - Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Payment Gateways - Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Payment Gateways - Cashfree
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=TEST

# Payment Gateways - PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Payment Gateways - PayTM
PAYTM_MERCHANT_ID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=
PAYTM_INDUSTRY_TYPE=
PAYTM_CHANNEL_ID=

# Payment Gateways - Midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Payment Gateways - Mollie
MOLLIE_API_KEY=

# Payment Gateways - PayFast
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_MODE=sandbox

# Payment Gateways - Instamojo
INSTAMOJO_API_KEY=
INSTAMOJO_AUTH_TOKEN=
INSTAMOJO_MODE=sandbox

# Payment Gateways - MercadoPago
MERCADOPAGO_ACCESS_TOKEN=

# Payment Gateways - Flutterwave
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=

# Payment Gateways - Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# InstantPay (Traffic Challan)
INSTANTPAY_BASE_URL=https://api.instantpay.in
INSTANTPAY_CLIENT_ID=
INSTANTPAY_CLIENT_SECRET=
INSTANTPAY_ENCRYPTION_KEY=
INSTANTPAY_AUTH_CODE=
INSTANTPAY_ENDPOINT_IP=
INSTANTPAY_USE_MOCK=false

# Social Login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/v1/auth/facebook/callback

# Pusher (Real-time)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# Redis (for queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
